#!/bin/bash

function tmx-bind
{
    if [ ! -z "$1" ] && ! tmux has-session -t "$1" 2>/dev/null; then
        echo "'$1' tmux pane doesn't exist"
    else
        export TMX_TARGET="$1"
    fi
}

if which fzf >/dev/null; then
function tmx-pick
{
    export TMX_TARGET=$(tmux list-panes -a -F "#S:#W.#P" | fzf --prompt="select tmux pane: ")
}
fi

function tmx-list
{
    tmux list-panes -a -F "#S:#W.#P"
}

function tmx
{
    local target=$TMX_TARGET
    if [ -z "$target" ]; then
        target=$1; shift
    fi

    local cmd=$*
    tmux send-keys -l -t "$target" "$cmd" &&
        tmux send-keys -t "$target" Enter
}

